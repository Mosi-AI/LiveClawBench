{
  "openapi": "3.0.0",
  "info": {
    "title": "Smart Home Mock API",
    "version": "1.0.0",
    "description": "Mock service for smart home automation with thermostat, inventory, shopping list, calendar, and meal planning"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "status": { "type": "string" },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/thermostat": {
      "get": {
        "tags": ["thermostat"],
        "summary": "Get thermostat settings",
        "responses": {
          "200": {
            "description": "Current thermostat settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "mode": { "type": "string", "enum": ["comfort", "eco", "off"] },
                    "temperature": { "type": "number" },
                    "updated_at": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["thermostat"],
        "summary": "Update thermostat settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": { "type": "string", "enum": ["comfort", "eco", "off"] },
                  "temperature": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated thermostat settings"
          }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["inventory"],
        "summary": "Get all inventory items",
        "responses": {
          "200": {
            "description": "List of inventory items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "item_name": { "type": "string" },
                      "quantity": { "type": "number" },
                      "unit": { "type": "string" },
                      "location": { "type": "string", "enum": ["fridge", "pantry"] },
                      "expiry_date": { "type": "string" },
                      "category": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["inventory"],
        "summary": "Add inventory item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item_name": { "type": "string" },
                  "quantity": { "type": "number" },
                  "unit": { "type": "string" },
                  "location": { "type": "string", "enum": ["fridge", "pantry"] },
                  "expiry_date": { "type": "string" },
                  "category": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Item created" }
        }
      }
    },
    "/api/inventory/{id}": {
      "put": {
        "tags": ["inventory"],
        "summary": "Update inventory item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Item updated" }
        }
      },
      "delete": {
        "tags": ["inventory"],
        "summary": "Delete inventory item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Item deleted" }
        }
      }
    },
    "/api/grocery/products": {
      "get": {
        "tags": ["shopping-list"],
        "summary": "Get all shopping list products",
        "responses": {
          "200": {
            "description": "List of grocery products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "product_id": { "type": "string" },
                      "name": { "type": "string" },
                      "quantity": { "type": "number" },
                      "unit": { "type": "string" },
                      "stock_status": { "type": "string", "enum": ["sufficient", "insufficient", "unavailable"] },
                      "substitute_for": { "type": "string" },
                      "reference": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["shopping-list"],
        "summary": "Add product to shopping list",
        "responses": {
          "201": { "description": "Product created" }
        }
      }
    },
    "/api/grocery/products/{id}": {
      "put": {
        "tags": ["shopping-list"],
        "summary": "Update shopping list product",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product updated" }
        }
      },
      "delete": {
        "tags": ["shopping-list"],
        "summary": "Delete shopping list product",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product deleted" }
        }
      }
    },
    "/api/calendar": {
      "get": {
        "tags": ["calendar"],
        "summary": "Get all calendar events",
        "responses": {
          "200": {
            "description": "List of calendar events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "title": { "type": "string" },
                      "start_time": { "type": "string" },
                      "event_type": { "type": "string" },
                      "workout_type": { "type": "string" },
                      "updated_at": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar/{id}": {
      "put": {
        "tags": ["calendar"],
        "summary": "Update calendar event",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Event updated" }
        }
      }
    },
    "/api/meal-plan": {
      "get": {
        "tags": ["meal-plan"],
        "summary": "Get current meal plan",
        "responses": {
          "200": {
            "description": "Current meal plan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan_id": { "type": "string" },
                    "created_at": { "type": "string" },
                    "plan_data": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "No meal plan found" }
        }
      },
      "post": {
        "tags": ["meal-plan"],
        "summary": "Create meal plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": { "type": "string" },
                        "meals": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "meal_type": { "type": "string", "enum": ["breakfast", "lunch", "dinner"] },
                              "meal_id": { "type": "integer" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Meal plan created" }
        }
      },
      "delete": {
        "tags": ["meal-plan"],
        "summary": "Delete current meal plan",
        "responses": {
          "200": { "description": "Meal plan deleted" },
          "404": { "description": "No meal plan to delete" }
        }
      }
    },
    "/api/recipes": {
      "get": {
        "tags": ["recipes"],
        "summary": "Get all recipes",
        "responses": {
          "200": {
            "description": "List of recipes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "meal_type": { "type": "string", "enum": ["breakfast", "lunch", "dinner"] },
                      "ingredients": { "type": "string" },
                      "calories_total": { "type": "number" },
                      "allergens": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/constraints": {
      "get": {
        "tags": ["constraints"],
        "summary": "Get user dietary constraints",
        "responses": {
          "200": {
            "description": "User constraints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "calorie_target": { "type": "number" },
                    "macro_targets": { "type": "string" },
                    "allergy_constraints": { "type": "string" },
                    "weekly_budget_limit": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}