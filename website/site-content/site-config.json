  "factors": [
    {
      "slug": "A1",
      "name": "Cross-Service Dependency",
      "Axis": "Environment",
      "Description": "Coordinate multiple independent services (email, airline, calendar) in a single workflow"
    },
    {
      "slug": "A2",
      "name": "Contaminated Initial State",
      "Axis": "Environment",
      "Description": "Environment starts broken or corrupt; agent must diagnose and repair before acting"
    },
    {
      "slug": "B1",
      "name": "Implicit Goal Resolution",
      "Axis": "Cognitive",
      "Description": "Goal is not stated explicitly; agent must infer constraints or seek clarification"
    },
    {
      "slug": "B2",
      "name": "Knowledge System Maintenance",
      "Axis": "Cognitive",
      "Description": "Create,update,resolve conflicts in,or manage a persistent skill/knowledge repository"
    },
    {
      "slug": "C1",
      "name": "Environmental State Invalidation",
      "Axis": "Runtime",
      "Description": "Replan when mid-execution environment changes invalidate established assumptions"
    },
    {
      "slug": "C2",
      "name": "Outcome Verification under Altered State",
      "Axis": "Runtime",
      "Description": "Actively verify task success when no simple pass/fail signal is available"
    }
  ]
}