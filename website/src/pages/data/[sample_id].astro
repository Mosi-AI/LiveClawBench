---
import PageLayout from '../../layouts/PageLayout.astro';
import rawRowsData from '../../../site-data/raw-rows.json';

interface TrajectoryStep {
  step_id: number;
  source: string;
  message?: string;
  reasoning_content?: string;
  tool_calls?: Array<{
    tool_call_id: string;
    function_name: string;
    arguments: Record<string, any>;
  }>;
  observation?: {
    results?: Array<{
      source_call_id?: string;
      content?: string;
    }>;
  };
  metrics?: {
    prompt_tokens?: number;
    completion_tokens?: number;
    cached_tokens?: number;
  };
}

interface TrajectoryData {
  schema_version: string;
  session_id: string;
  agent: {
    name: string;
    version: string;
    model_name: string;
  };
  steps: TrajectoryStep[];
}

const difficultyClass: Record<string, string> = {
  E: 'bg-green-100 text-green-800',
  M: 'bg-yellow-100 text-yellow-800',
  H: 'bg-red-100 text-red-800',
};

const difficultyLabel: Record<string, string> = {
  E: 'Easy',
  M: 'Medium',
  H: 'Hard',
};

const factorColorMap: Record<string, string> = {
  A1: 'bg-orange-50 text-orange-700',
  A2: 'bg-red-50 text-red-700',
  B1: 'bg-purple-50 text-purple-700',
  B2: 'bg-green-50 text-green-700',
  C1: 'bg-cyan-50 text-cyan-700',
  C2: 'bg-blue-50 text-blue-700',
};

export function getStaticPaths() {
  const rows = rawRowsData as any[];
  return rows.map((row) => ({
    params: { sample_id: row.sample_id },
    props: { row },
  }));
}

const { row } = Astro.props;

// Parse trajectory JSON
let trajectory: TrajectoryData | null = null;
let parseError = '';
try {
  trajectory = JSON.parse(row.trajectory || '{}');
} catch (e) {
  parseError = 'Failed to parse trajectory data';
}

const steps = trajectory?.steps || [];
const agentInfo = trajectory?.agent;

// Compute metrics
const totalPromptTokens = steps.reduce((sum, s) => sum + (s.metrics?.prompt_tokens || 0), 0);
const totalCompletionTokens = steps.reduce((sum, s) => sum + (s.metrics?.completion_tokens || 0), 0);
const toolCallSteps = steps.filter(s => s.tool_calls && s.tool_calls.length > 0);
const totalToolCalls = toolCallSteps.reduce((sum, s) => sum + (s.tool_calls?.length || 0), 0);

// Collect unique tool names
const toolNames = new Set<string>();
toolCallSteps.forEach(s => s.tool_calls?.forEach(tc => toolNames.add(tc.function_name)));

const sourceIcon: Record<string, string> = {
  user: '👤',
  agent: '🤖',
  system: '⚙️',
};
---

<PageLayout title={`Trajectory: ${row.sample_id} - LiveClawBench`}>
  <div class="container mx-auto px-4 py-12 max-w-5xl">
    <!-- Back link -->
    <a href="/data" class="text-primary-600 hover:text-primary-700 text-sm font-medium mb-4 inline-block">← Back to Trajectory Data</a>

    <h1 class="text-2xl font-bold mb-1">Trajectory Detail</h1>
    <p class="text-gray-500 text-sm mb-6 font-mono">{row.sample_id}</p>

    <!-- Metadata Card -->
    <div class="bg-white rounded-xl border p-6 mb-6">
      <h2 class="font-bold text-lg mb-4">Metadata</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Model</span>
          <span class="text-gray-800 font-medium">{row.model_name}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Case ID</span>
          <span class="text-gray-800">{row.case_id}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Case Name</span>
          <span class="text-gray-800">{row.case_name}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Difficulty</span>
          <span>
            <span class={`px-1.5 py-0.5 rounded-full text-xs font-medium ${difficultyClass[row.difficulty] || 'bg-gray-100 text-gray-800'}`}>
              {row.difficulty}
            </span>
            <span class="text-gray-400 ml-1 text-xs">{difficultyLabel[row.difficulty] || ''}</span>
          </span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Domain</span>
          <span class="text-gray-800">{row.domain}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Multi-domain</span>
          <span class="text-gray-800">{row.domains_multi || '—'}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Ability Category</span>
          <span class="text-gray-800">{row.ability_category}</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-gray-500 w-36 shrink-0">Complexity Factors</span>
          <div class="flex flex-wrap gap-1">
            {(row.complexity_factor || []).map((f: string) => (
              <span class={`px-1.5 py-0.5 rounded text-xs ${factorColorMap[f] || 'bg-gray-50 text-gray-700'}`}>{f}</span>
            ))}
            {(!row.complexity_factor || row.complexity_factor.length === 0) && (
              <span class="text-gray-300">—</span>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Agent Info Card -->
    {agentInfo && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-4">Agent Info</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="flex items-start gap-3">
            <span class="text-gray-500 w-28 shrink-0">Name</span>
            <span class="text-gray-800">{agentInfo.name}</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-gray-500 w-28 shrink-0">Version</span>
            <span class="text-gray-800">{agentInfo.version}</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-gray-500 w-28 shrink-0">Model</span>
            <span class="text-gray-800 font-mono text-xs">{agentInfo.model_name}</span>
          </div>
        </div>
      </div>
    )}

    <!-- Stats Card -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-lg p-4 border text-center">
        <div class="text-2xl font-bold text-primary-600">{steps.length}</div>
        <div class="text-xs text-gray-500 mt-1">Total Steps</div>
      </div>
      <div class="bg-white rounded-lg p-4 border text-center">
        <div class="text-2xl font-bold text-primary-600">{totalToolCalls}</div>
        <div class="text-xs text-gray-500 mt-1">Tool Calls</div>
      </div>
      <div class="bg-white rounded-lg p-4 border text-center">
        <div class="text-2xl font-bold text-primary-600">{totalPromptTokens.toLocaleString()}</div>
        <div class="text-xs text-gray-500 mt-1">Prompt Tokens</div>
      </div>
      <div class="bg-white rounded-lg p-4 border text-center">
        <div class="text-2xl font-bold text-primary-600">{totalCompletionTokens.toLocaleString()}</div>
        <div class="text-xs text-gray-500 mt-1">Completion Tokens</div>
      </div>
    </div>

    <!-- Tools Used -->
    {toolNames.size > 0 && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Tools Used</h2>
        <div class="flex flex-wrap gap-2">
          {[...toolNames].map(name => (
            <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-medium">{name}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Trajectory Steps -->
    <div class="bg-white rounded-xl border p-6 mb-6">
      <h2 class="font-bold text-lg mb-4">Trajectory Steps</h2>

      {parseError && (
        <div class="text-red-500 text-sm">{parseError}</div>
      )}

      {steps.length === 0 && !parseError && (
        <p class="text-gray-400 italic">No trajectory steps available.</p>
      )}

      <div class="space-y-4">
        {steps.map((step, idx) => (
          <div class="border rounded-lg overflow-hidden">
            <!-- Step Header -->
            <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 border-b">
              <span class="text-lg">{sourceIcon[step.source] || '📋'}</span>
              <span class="font-semibold text-sm text-gray-800">
                Step {step.step_id}
              </span>
              <span class={`px-1.5 py-0.5 rounded text-xs font-medium ${
                step.source === 'user' ? 'bg-blue-100 text-blue-800' :
                step.source === 'agent' ? 'bg-indigo-100 text-indigo-800' :
                'bg-gray-100 text-gray-800'
              }`}>
                {step.source}
              </span>
              {step.tool_calls && step.tool_calls.length > 0 && (
                <span class="px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">
                  {step.tool_calls.length} tool call{step.tool_calls.length > 1 ? 's' : ''}
                </span>
              )}
              {step.metrics && (
                <span class="text-xs text-gray-400 ml-auto">
                  {step.metrics.prompt_tokens?.toLocaleString()} → {step.metrics.completion_tokens?.toLocaleString()} tokens
                  {step.metrics.cached_tokens ? ` (${step.metrics.cached_tokens.toLocaleString()} cached)` : ''}
                </span>
              )}
            </div>

            <div class="px-4 py-3 space-y-3 text-sm">
              <!-- Message -->
              {step.message && (
                <div class="text-gray-700 whitespace-pre-wrap">{step.message}</div>
              )}

              <!-- Reasoning (collapsible) -->
              {step.reasoning_content && (
                <details class="group">
                  <summary class="cursor-pointer text-xs text-purple-600 hover:text-purple-700 font-medium">
                    💭 Reasoning
                  </summary>
                  <div class="mt-2 p-3 bg-purple-50 rounded text-xs text-gray-700 whitespace-pre-wrap max-h-64 overflow-y-auto">
                    {step.reasoning_content}
                  </div>
                </details>
              )}

              <!-- Tool Calls -->
              {step.tool_calls && step.tool_calls.length > 0 && (
                <div class="space-y-2">
                  {step.tool_calls.map((tc, tcIdx) => (
                    <div class="bg-amber-50 rounded p-3">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-semibold text-amber-800">🔧 {tc.function_name}</span>
                      </div>
                      <pre class="text-xs text-gray-700 whitespace-pre-wrap break-all max-h-40 overflow-y-auto">{JSON.stringify(tc.arguments, null, 2)}</pre>
                    </div>
                  ))}
                </div>
              )}

              <!-- Observation -->
              {step.observation?.results && step.observation.results.length > 0 && (
                <details class="group">
                  <summary class="cursor-pointer text-xs text-green-600 hover:text-green-700 font-medium">
                    📋 Observation ({step.observation.results.length} result{step.observation.results.length > 1 ? 's' : ''})
                  </summary>
                  <div class="mt-2 space-y-2 max-h-64 overflow-y-auto">
                    {step.observation.results.map((obs, obsIdx) => (
                      <div class="bg-green-50 rounded p-2">
                        <pre class="text-xs text-gray-700 whitespace-pre-wrap break-all">{obs.content || JSON.stringify(obs, null, 2)}</pre>
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Back link -->
    <a href="/data" class="text-primary-600 hover:text-primary-700 text-sm font-medium">← Back to Trajectory Data</a>
  </div>
</PageLayout>
