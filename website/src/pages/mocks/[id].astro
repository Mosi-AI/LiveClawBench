---
import PageLayout from '../../layouts/PageLayout.astro';
import PreviewGallery from '../../components/mocks/PreviewGallery.tsx';
import { getAllMockApps } from '../../data/mocks';
import { getGithubFileUrl, getGithubDirUrl } from '../../data/site-config';
import type { MockApp } from '../../data/types';

export function getStaticPaths() {
  const mockApps = getAllMockApps();
  return mockApps.map(app => ({
    params: { id: app.id },
    props: { app },
  }));
}

interface Props {
  app: MockApp;
}

const { app } = Astro.props;
---

<PageLayout title={`${app.name} Mock App - LiveClawBench`}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <a href="/mocks" class="text-sm text-gray-500 hover:text-gray-700">← Mock Apps</a>
      </div>
      <h1 class="text-3xl font-bold">{app.name} Mock App</h1>
      <div class="mt-2 flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          Live Demo Coming Soon
        </span>
        <span class="text-sm text-gray-500">{app.tasksCount} tasks</span>
      </div>
    </div>

    <!-- Overview -->
    <div class="bg-white rounded-xl border p-6 mb-6">
      <h2 class="font-bold text-lg mb-3">Overview</h2>
      <p class="text-gray-700">{app.summary}</p>
    </div>

    <!-- Demo Recording -->
    {app.demoGif && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Demo Recording</h2>
        <div class="rounded-lg overflow-hidden bg-gray-100">
          <img src={app.demoGif} alt={`${app.name} demo`} class="w-full" />
        </div>
        <p class="text-xs text-gray-400 mt-2">Short recording showing typical usage flow</p>
      </div>
    )}

    <!-- Preview Gallery -->
    <div class="bg-white rounded-xl border p-6 mb-6">
      <h2 class="font-bold text-lg mb-3">Preview Gallery</h2>
      <PreviewGallery client:visible assets={app.previewAssets} />
    </div>

    <!-- Main Screens -->
    {app.mainScreens.length > 0 && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Main Screens</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {app.mainScreens.map(screen => (
            <div class="group">
              <div class="aspect-[4/3] bg-gray-100 rounded-lg overflow-hidden border border-gray-200 group-hover:border-primary-300 transition-colors">
                <img src={screen.src} alt={screen.name} class="w-full h-full object-cover" />
              </div>
              <p class="mt-1.5 text-sm text-gray-600 text-center truncate">{screen.name}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Agent Actions -->
    {app.agentActions.length > 0 && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Agent Actions</h2>
        <div class="flex flex-wrap gap-2">
          {app.agentActions.map(action => (
            <span class="px-3 py-1.5 bg-primary-50 rounded-lg text-sm text-primary-700">{action}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Used by Tasks -->
    {app.usedByTasks.length > 0 && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Used by Tasks</h2>
        <div class="space-y-2">
          {app.usedByTasks.map(taskSlug => (
            <a href={`/tasks/${taskSlug}`} class="block text-sm text-primary-600 hover:text-primary-700 hover:underline">
              {taskSlug}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Source Files -->
    {app.sourceFiles.length > 0 && (
      <div class="bg-white rounded-xl border p-6 mb-6">
        <h2 class="font-bold text-lg mb-3">Source Files</h2>
        <div class="space-y-2">
          {app.sourceFiles.map(file => {
            const isDir = file.endsWith('/');
            const githubUrl = isDir ? getGithubDirUrl(file) : getGithubFileUrl(file);
            return (
              <div class="flex items-center gap-2 text-sm">
                <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-xs bg-gray-100 px-2 py-0.5 rounded text-primary-600 hover:text-primary-700 hover:underline">{file}</a>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </div>
</PageLayout>
