---
import { getFactorMap } from '../../data/site-config';

interface Props {
  name: string;
  difficulty: string;
  domain: string;
  factors: Record<string, boolean>;
  mockApps: string[];
}

const { name, difficulty, domain, factors, mockApps } = Astro.props;
const factorMap = getFactorMap();

const activeFactors = Object.entries(factors)
  .filter(([_, active]) => active)
  .map(([key]) => key);

const difficultyClass: Record<string, string> = {
  easy: 'bg-green-100 text-green-800',
  medium: 'bg-yellow-100 text-yellow-800',
  hard: 'bg-red-100 text-red-800',
};
---

<a href={`/tasks/${name}`} class="block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md hover:border-gray-300 transition-all duration-200">
  <div class="p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="font-semibold text-gray-900">{name}</h3>
      <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${difficultyClass[difficulty] || 'bg-gray-100 text-gray-800'}`}>
        {difficulty}
      </span>
    </div>
    <p class="text-sm text-gray-500">{domain}</p>
    <div class="flex flex-wrap gap-1">
      {activeFactors.map(f => (
        <span class={`px-2 py-0.5 rounded text-xs border ${
          f === 'A1' ? 'bg-orange-50 text-orange-700 border-orange-200' :
          f === 'A2' ? 'bg-red-50 text-red-700 border-red-200' :
          f === 'B1' ? 'bg-purple-50 text-purple-700 border-purple-200' :
          f === 'B2' ? 'bg-green-50 text-green-700 border-green-200' :
          f === 'C1' ? 'bg-cyan-50 text-cyan-700 border-cyan-200' :
          'bg-blue-50 text-blue-700 border-blue-200'
        }`} title={factorMap[f]?.Description || ''}>
          {f}
        </span>
      ))}
      {mockApps.map(app => (
        <span class="px-2 py-0.5 rounded-full text-xs bg-blue-50 text-blue-700">
          {app}
        </span>
      ))}
    </div>
  </div>
</a>
