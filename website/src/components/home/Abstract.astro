---
import { getSiteConfig, getFactorSlugs } from '../../data/site-config';

const config = getSiteConfig();
const factorSlugs = getFactorSlugs();
const factorSummary = factorSlugs.join(', ');
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">What is LiveClawBench?</h2>
    <div class="prose prose-gray max-w-none">
      <p>LiveClawBench is a benchmark for evaluating LLM Agents on complex, real-world assistant tasks.</p>
      <p>Think of it as a <strong>standardized exam + standardized exam room + auto-grading system</strong>:</p>
      <ul>
        <li><strong>Standardized Exam</strong>: Each case is a real assistant task — shopping, email, booking flights, fixing code, recovering databases.</li>
        <li><strong>Standardized Exam Room</strong>: Each task has a fixed initial environment where the agent sees consistent web pages, databases, emails, and file states.</li>
        <li><strong>Auto-Grading</strong>: After task completion, a verifier checks the result and assigns a score from 0 to 1.</li>
      </ul>
    </div>

    <!-- Core Value Sections -->
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="p-6 bg-gray-50 rounded-xl border">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">🔄</span>
          <h3 class="font-bold text-lg">Real Assistant Workflows</h3>
        </div>
        <p class="text-sm text-gray-600">Tasks are derived from genuine multi-step assistant scenarios, not synthetic toy problems.</p>
      </div>
      <div class="p-6 bg-gray-50 rounded-xl border">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">📐</span>
          <h3 class="font-bold text-lg">Triple-Axis Complexity</h3>
        </div>
        <p class="text-sm text-gray-600">Six complexity factors ({factorSummary}) along {config.factors.map(f => f.Axis).filter((v, i, a) => a.indexOf(v) === i).join(', ')} axes.</p>
      </div>
      <div class="p-6 bg-gray-50 rounded-xl border">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">🖥️</span>
          <h3 class="font-bold text-lg">Deterministic Mock Environments</h3>
        </div>
        <p class="text-sm text-gray-600">Every task runs in a controlled mock environment ensuring reproducible and fair evaluation.</p>
      </div>
      <div class="p-6 bg-gray-50 rounded-xl border">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">✅</span>
          <h3 class="font-bold text-lg">Outcome-Driven Evaluation</h3>
        </div>
        <p class="text-sm text-gray-600">Evaluation is based on final outcomes, not intermediate steps — did the agent actually complete the task?</p>
      </div>
    </div>
  </div>
</section>
