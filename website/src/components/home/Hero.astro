---
import fs from 'fs';
import path from 'path';
import { getSiteConfig } from '../../data/site-config';
import { getAllTasks } from '../../data/tasks';
import { withBase } from '../../lib/urls';

const config = getSiteConfig();

// Use process.cwd() as project root (reliable during Astro build)
const projectRoot = process.cwd();

// Compute stats from data sources
const tasksCount = getAllTasks().length;

// Read leaderboard data
const leaderboardPath = path.join(projectRoot, 'site-data', 'leaderboard.json');
const leaderboardData = fs.existsSync(leaderboardPath) ? JSON.parse(fs.readFileSync(leaderboardPath, 'utf-8')) : { models: [] };
const topModel = leaderboardData.models.length > 0 ? leaderboardData.models[0].model : '';
const topScore = leaderboardData.models.length > 0 ? leaderboardData.models[0].overall : 0;
const modelsCount = leaderboardData.models.length;

// Read trajectory data
const trajectoryPath = path.join(projectRoot, 'site-data', 'trajectory-distribution.json');
const trajectoryData = fs.existsSync(trajectoryPath) ? JSON.parse(fs.readFileSync(trajectoryPath, 'utf-8')) : {};
const trajectoriesCount = trajectoryData.totalTrajectories || 0;

// Count domains from domains.toml (each [[domain]] entry)
const domainsTomlPath = path.join(projectRoot, 'site-data', 'domains.toml');
const domainsToml = fs.existsSync(domainsTomlPath) ? fs.readFileSync(domainsTomlPath, 'utf-8') : '';
const domainsCount = (domainsToml.match(/\[\[domain\]\]/g) || []).length;
---

<section class="py-8 md:py-12">
  <div class="container mx-auto px-4 text-center">
    <!-- Paper-style Title Block -->
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight max-w-4xl mx-auto">
      LiveClawBench: {config.subtitle}
    </h1>

    <!-- Authors with superscript affiliation numbers -->
    <div class="mt-6 text-base text-gray-600 leading-relaxed max-w-5xl mx-auto">
      {config.members.map((member, idx) => (
        <>
          <a
            href={member.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-900 hover:text-black transition-colors"
          >
            {member.name}<sup>{member.affiliations.join(',')}</sup>
          </a>
          {idx < config.members.length - 1 && <span class="text-gray-400">, </span>}
        </>
      ))}
    </div>

    <!-- Affiliations -->
    <div class="mt-3 text-sm text-gray-500">
      {config.affiliations.map((aff, idx) => (
        <>
<sup>{aff.id}</sup><a href={aff.url} target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors">{aff.name}</a>
          {idx < config.affiliations.length - 1 && <span class="text-gray-400">, </span>}
        </>
      ))}
    </div>

    <!-- Brief Description -->
    <p class="mt-4 text-base text-gray-500 max-w-2xl mx-auto">
      A <strong class="text-gray-700">"standardized exam"</strong> for LLM Agents with high fidelity— Including 134 Cases acrossing 10 domains, 22 reusable mock services, with 6 complexity factors to make task-distribution fidelity inspectable, auditable, and extensible.
    </p>

    <!-- Action Buttons (OSWorld-style: dark rounded with icons) -->
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={config.links.paper} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-800 text-white rounded-full font-medium hover:bg-gray-700 transition-colors text-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2H3.5C2.7 2 2 2.7 2 3.5v17c0 .8.7 1.5 1.5 1.5h17c.8 0 1.5-.7 1.5-1.5v-17c0-.8-.7-1.5-1.5-1.5zM7 18.5l-2-1V6.5l2-1v13zm4-13h2v13h-2v-13zm6 12l-2 1v-13l2 1v11z"/></svg>
        <span>Paper</span>
      </a>
      <a href={config.links.code} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-800 text-white rounded-full font-medium hover:bg-gray-700 transition-colors text-sm">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>Code</span>
      </a>
      <a href={config.links.data} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-800 text-white rounded-full font-medium hover:bg-gray-700 transition-colors text-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        <span>Data</span>
      </a>
      <a href={withBase(config.links.data_viewer)} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-800 text-white rounded-full font-medium hover:bg-gray-700 transition-colors text-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <span>Data Viewer</span>
      </a>
    </div>
  </div>
</section>
