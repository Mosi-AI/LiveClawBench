---
import { requireAuth } from '../../lib/auth';
import { postQueries } from '../../lib/database';

const user = requireAuth(Astro);
if (user instanceof Response) return user;

// Fetch all posts
const posts = postQueries.findAll();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Posts | Stellar-DB Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #1a1a2e; color: #f1f1f1; min-height: 100vh; }
    .admin-layout { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
    .sidebar { background: #16213e; border-right: 1px solid #0f3460; padding: 1.5rem; }
    .sidebar-header { margin-bottom: 2rem; }
    .sidebar-header h1 { font-size: 1.5rem; }
    .sidebar-header h1 span { color: #e94560; }
    .nav { list-style: none; }
    .nav li { margin-bottom: 0.25rem; }
    .nav a { display: block; padding: 0.75rem 1rem; color: #b8b8b8; text-decoration: none; border-radius: 4px; }
    .nav a:hover, .nav a.active { background: #0f3460; color: #f1f1f1; }
    .main { padding: 2rem; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-header h2 { font-size: 1.75rem; }
    .btn { background: #e94560; color: white; padding: 0.625rem 1.25rem; border-radius: 4px; text-decoration: none; }
    .table { background: #16213e; border: 1px solid #0f3460; border-radius: 8px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 1rem 1.5rem; text-align: left; }
    th { color: #b8b8b8; font-weight: 500; font-size: 0.875rem; border-bottom: 1px solid #0f3460; }
    td { border-bottom: 1px solid #0f3460; }
    tr:last-child td { border-bottom: none; }
    .status { padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; text-transform: capitalize; }
    .status.published { background: rgba(34, 197, 94, 0.2); color: #22c55e; }
    .status.draft { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
    .actions { display: flex; gap: 0.5rem; }
    .action-btn { background: transparent; border: 1px solid #0f3460; color: #b8b8b8; padding: 0.375rem 0.75rem; border-radius: 4px; text-decoration: none; font-size: 0.75rem; }
    .action-btn:hover { border-color: #e94560; color: #e94560; }
    .empty { text-align: center; padding: 3rem; color: #b8b8b8; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-header"><h1>Stellar<span>DB</span></h1></div>
      <ul class="nav">
        <li><a href="/admin">Dashboard</a></li>
        <li><a href="/admin/posts" class="active">Posts</a></li>
        <li><a href="/admin/write">Write New</a></li>
        <li><a href="/admin/media">Media</a></li>
        <li><a href="/admin/settings">Settings</a></li>
        <li style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #0f3460;"><a href="/" style="color: #e94560;">← View Site</a></li>
      </ul>
    </aside>
    <main class="main">
      <div class="page-header">
        <h2>All Posts ({posts.length})</h2>
        <a href="/admin/write" class="btn">+ New Post</a>
      </div>
      {posts.length > 0 ? (
        <div class="table">
          <table>
            <thead><tr><th>Title</th><th>Status</th><th>Views</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>
              {posts.map(post => (
                <tr>
                  <td>{post.title}</td>
                  <td><span class={`status ${post.status}`}>{post.status}</span></td>
                  <td>{post.view_count}</td>
                  <td>{new Date(post.created_at).toLocaleDateString()}</td>
                  <td>
                    <div class="actions">
                      <a href={`/blog/${post.slug}`} class="action-btn" target="_blank">View</a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty">No posts yet. <a href="/admin/write">Write your first post</a>.</div>
      )}
    </main>
  </div>
</body>
</html>
