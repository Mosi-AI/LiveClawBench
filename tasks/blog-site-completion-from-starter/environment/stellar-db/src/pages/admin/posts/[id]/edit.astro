---
import { requireAuth } from '../../../../lib/auth';
import { postQueries } from '../../../../lib/database';
import { generateExcerpt, generateSlug } from '../../../../lib/markdown';

const user = requireAuth(Astro);
if (user instanceof Response) return user;
const { id } = Astro.params;

const post = postQueries.findById(parseInt(id as string));

if (!post) {
  return Astro.redirect('/admin/posts');
}

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = formData.get('title') as string;
  const content = formData.get('content') as string;
  const status = formData.get('status') as 'draft' | 'published';
  let slug = formData.get('slug') as string;

  if (!title || !content) {
    error = 'Title and content are required';
  } else {
    if (!slug) {
      slug = generateSlug(title);
    } else {
      slug = slug.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').substring(0, 100);
    }

    // Don't allow slug collision with other posts
    const existing = postQueries.findBySlug(slug);
    if (existing && existing.id !== post.id) {
      let counter = 1;
      let newSlug = `${slug}-${counter}`;
      while (postQueries.findBySlug(newSlug)) {
        counter++;
        newSlug = `${slug}-${counter}`;
      }
      slug = newSlug;
    }

    const excerpt = generateExcerpt(content);
    const publishedAt = status === 'published' && !post.published_at
      ? new Date().toISOString()
      : post.published_at;

    try {
      postQueries.update(post.id, {
        title,
        slug,
        content,
        excerpt,
        status,
        published_at: publishedAt
      });
      return Astro.redirect('/admin/posts');
    } catch (err: any) {
      error = 'Failed to update post: ' + err.message;
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit: {post.title} | Stellar-DB Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #1a1a2e; color: #f1f1f1; min-height: 100vh; }
    .admin-layout { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
    .sidebar { background: #16213e; border-right: 1px solid #0f3460; padding: 1.5rem; }
    .sidebar-header { margin-bottom: 2rem; }
    .sidebar-header h1 { font-size: 1.5rem; }
    .sidebar-header h1 span { color: #e94560; }
    .nav { list-style: none; }
    .nav a { display: block; padding: 0.75rem 1rem; color: #b8b8b8; text-decoration: none; border-radius: 4px; }
    .nav a:hover, .nav a.active { background: #0f3460; color: #f1f1f1; }
    .main { padding: 2rem; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-header h2 { font-size: 1.75rem; }
    .btn-secondary { background: #0f3460; color: white; text-decoration: none; padding: 0.625rem 1.25rem; border-radius: 4px; }
    .alert { padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem; background: rgba(233, 69, 96, 0.2); border: 1px solid #e94560; color: #e94560; }
    .editor-form { display: grid; grid-template-columns: 1fr 300px; gap: 2rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.5rem; color: #b8b8b8; font-size: 0.875rem; }
    .form-group input, .form-group textarea, .form-group select {
      width: 100%; background: #16213e; border: 1px solid #0f3460; color: #f1f1f1;
      padding: 0.75rem 1rem; border-radius: 4px; font-size: 1rem;
    }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: #e94560; }
    .form-group textarea { min-height: 400px; resize: vertical; font-family: monospace; font-size: 0.9rem; }
    .sidebar-section { background: #16213e; border: 1px solid #0f3460; border-radius: 8px; padding: 1.25rem; }
    .sidebar-section h3 { font-size: 0.875rem; color: #b8b8b8; margin-bottom: 1rem; text-transform: uppercase; }
    .btn { width: 100%; background: #e94560; color: white; border: none; padding: 0.75rem 1rem; border-radius: 4px; cursor: pointer; margin-bottom: 0.5rem; }
    .btn:hover { opacity: 0.9; }
    .delete-btn { background: #dc2626; }
    .slug-preview { font-size: 0.875rem; color: #b8b8b8; margin-top: 0.25rem; }
    .meta { color: #b8b8b8; font-size: 0.875rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-header"><h1>Stellar<span>DB</span></h1></div>
      <ul class="nav">
        <li><a href="/admin">Dashboard</a></li>
        <li><a href="/admin/posts" class="active">Posts</a></li>
        <li><a href="/admin/write">Write New</a></li>
        <li><a href="/admin/media">Media</a></li>
        <li><a href="/admin/settings">Settings</a></li>
        <li style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #0f3460;"><a href="/" style="color: #e94560;">← View Site</a></li>
      </ul>
    </aside>
    <main class="main">
      <div class="page-header">
        <h2>Edit Post</h2>
        <a href="/admin/posts" class="btn-secondary">← Back</a>
      </div>
      {error && <div class="alert">{error}</div>}
      <div class="meta">Created: {new Date(post.created_at).toLocaleDateString()} | Views: {post.view_count}</div>
      <form method="POST" class="editor-form">
        <div class="editor-main">
          <div class="form-group">
            <input type="text" name="title" value={post.title} placeholder="Post title" required style="font-size: 1.5rem; font-weight: 600;" />
          </div>
          <div class="form-group">
            <input type="text" name="slug" value={post.slug} placeholder="url-slug" />
            <div class="slug-preview">/blog/{post.slug}</div>
          </div>
          <div class="form-group">
            <textarea name="content" placeholder="Write in Markdown..." required>{post.content}</textarea>
          </div>
        </div>
        <div class="editor-sidebar">
          <div class="sidebar-section">
            <h3>Publish</h3>
            <div class="form-group">
              <label>Status</label>
              <select name="status">
                <option value="draft" selected={post.status === 'draft'}>Draft</option>
                <option value="published" selected={post.status === 'published'}>Published</option>
                <option value="archived" selected={post.status === 'archived'}>Archived</option>
              </select>
            </div>
            <button type="submit" class="btn">Update Post</button>
          </div>
        </div>
      </form>
      <form method="POST" action={`/admin/posts/${post.id}/delete`} style="margin-top: 2rem;" onsubmit="return confirm('Delete this post forever?')">
        <button type="submit" class="btn delete-btn">Delete Post</button>
      </form>
    </main>
  </div>
</body>
</html>
