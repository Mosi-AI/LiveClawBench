---
import { login, createAdminUser, checkAuth } from '../lib/auth';
import { getDatabase } from '../lib/database';

// If already logged in, redirect to appropriate dashboard
const user = checkAuth(Astro);
if (user) {
  // Redirect admin/editor to admin, regular users to dashboard
  const redirectUrl = (user.role === 'admin' || user.role === 'editor') ? '/admin' : '/dashboard';
  return Astro.redirect(redirectUrl);
}

// Check if initial setup is needed
const needsSetup = (() => {
  const db = getDatabase();
  const userCount = db.prepare('SELECT COUNT(*) as count FROM users').get() as { count: number };
  return userCount.count === 0;
})();

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  if (needsSetup) {
    // Create initial admin
    const username = formData.get('username') as string;
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;
    const confirmPassword = formData.get('confirm_password') as string;

    if (!username || !email || !password) {
      error = 'All fields are required';
    } else if (password.length < 8) {
      error = 'Password must be at least 8 characters';
    } else if (password !== confirmPassword) {
      error = 'Passwords do not match';
    } else {
      const result = await createAdminUser(username, email, password);
      if (result.success) {
        success = 'Admin user created successfully. You can now log in.';
      } else {
        error = result.message;
      }
    }
  } else {
    // Regular login
    const username = formData.get('username') as string;
    const password = formData.get('password') as string;

    const result = await login({ username, password });

    if (result) {
      // Redirect based on user role
      const redirect = (result.user.role === 'admin' || result.user.role === 'editor') ? '/admin' : '/dashboard';

      // Manually construct Set-Cookie header
      const cookieValue = `auth-token=${result.token}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${7 * 24 * 60 * 60}`;

      // Return redirect with Set-Cookie header
      return new Response(null, {
        status: 302,
        headers: {
          'Location': redirect,
          'Set-Cookie': cookieValue
        }
      });
    } else {
      error = 'Invalid username or password';
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{needsSetup ? 'Setup' : 'Login'} | Stellar-DB</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #1a1a2e;
      color: #f1f1f1;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .login-container {
      width: 100%;
      max-width: 400px;
    }

    .login-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .login-header h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .login-header h1 span {
      color: #e94560;
    }

    .login-header p {
      color: #b8b8b8;
    }

    .login-form {
      background: #16213e;
      border: 1px solid #0f3460;
      border-radius: 8px;
      padding: 2rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      font-size: 0.875rem;
    }

    .form-group input {
      width: 100%;
      background: #1a1a2e;
      border: 1px solid #0f3460;
      color: #f1f1f1;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-size: 1rem;
    }

    .form-group input:focus {
      outline: none;
      border-color: #e94560;
    }

    .btn {
      width: 100%;
      background: #e94560;
      color: white;
      border: none;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }

    .alert-error {
      background: rgba(233, 69, 96, 0.2);
      border: 1px solid #e94560;
      color: #e94560;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.2);
      border: 1px solid #22c55e;
      color: #22c55e;
    }

    .setup-notice {
      background: rgba(233, 69, 96, 0.1);
      border: 1px solid #e94560;
      border-radius: 4px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
    }

    .setup-notice h3 {
      margin-bottom: 0.5rem;
      color: #e94560;
    }

    .login-footer {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #0f3460;
    }

    .login-footer p {
      color: #b8b8b8;
      font-size: 0.875rem;
    }

    .login-footer a {
      color: #e94560;
      text-decoration: none;
      font-weight: 500;
    }

    .login-footer a:hover {
      text-decoration: underline;
    }

    .back-link {
      text-align: center;
      margin-top: 1.5rem;
    }

    .back-link a {
      color: #b8b8b8;
      text-decoration: none;
      font-size: 0.875rem;
    }

    .back-link a:hover {
      color: #f1f1f1;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-header">
      <h1>Stellar<span>DB</span></h1>
      <p>{needsSetup ? 'Initial Setup' : 'Welcome Back'}</p>
    </div>

    <div class="login-form">
      {needsSetup && (
        <div class="setup-notice">
          <h3>Welcome to Stellar-DB!</h3>
          <p>This appears to be a fresh installation. Please create an admin user to get started.</p>
        </div>
      )}

      {error && <div class="alert alert-error">{error}</div>}
      {success && <div class="alert alert-success">{success}</div>}

      <form method="POST">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autocomplete="username" />
        </div>

        {needsSetup && (
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
        )}

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete={needsSetup ? "new-password" : "current-password"} />
        </div>

        {needsSetup && (
          <div class="form-group">
            <label for="confirm_password">Confirm Password</label>
            <input type="password" id="confirm_password" name="confirm_password" required />
          </div>
        )}

        <button type="submit" class="btn">
          {needsSetup ? 'Create Admin Account' : 'Sign In'}
        </button>
      </form>

      {!needsSetup && (
        <div class="login-footer">
          <p>Don't have an account? <a href="/register">Register here</a></p>
        </div>
      )}
    </div>

    <div class="back-link">
      <a href="/">← Back to Home</a>
    </div>
  </div>
</body>
</html>
