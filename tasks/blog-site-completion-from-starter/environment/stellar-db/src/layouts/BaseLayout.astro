---
import { getDatabase, settingsQueries } from '../lib/database';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Get site settings
const siteTitle = settingsQueries.get('blog_title') || 'Stellar-DB';
const siteDescription = settingsQueries.get('blog_description') || 'A self-hosted, Local-First blog platform';
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const metaDescription = description || siteDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.url);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:type" content="website">
  {image && <meta property="og:image" content={new URL(image, Astro.url)}>}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={metaDescription}>
  {image && <meta name="twitter:image" content={new URL(image, Astro.url)}>}

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <style is:global>
    :root {
      --color-primary: #1a1a2e;
      --color-secondary: #16213e;
      --color-accent: #0f3460;
      --color-highlight: #e94560;
      --color-text: #f1f1f1;
      --color-text-muted: #b8b8b8;
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 16px;
      line-height: 1.6;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--color-primary);
      color: var(--color-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: var(--color-highlight);
      text-decoration: none;
      transition: opacity 0.2s;
    }

    a:hover {
      opacity: 0.8;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    /* Prose styles */
    .prose {
      max-width: 70ch;
      line-height: 1.75;
    }

    .prose h1, .prose h2, .prose h3, .prose h4 {
      margin-top: 1.5em;
      margin-bottom: 0.5em;
      line-height: 1.3;
    }

    .prose p {
      margin-bottom: 1em;
    }

    .prose code {
      font-family: var(--font-mono);
      background: var(--color-secondary);
      padding: 0.125em 0.375em;
      border-radius: 4px;
      font-size: 0.875em;
    }

    .prose pre {
      background: var(--color-secondary);
      padding: 1em;
      border-radius: 8px;
      overflow-x: auto;
      margin-bottom: 1em;
    }

    .prose pre code {
      background: none;
      padding: 0;
    }

    .prose blockquote {
      border-left: 4px solid var(--color-highlight);
      padding-left: 1em;
      margin-left: 0;
      font-style: italic;
    }

    .prose ul, .prose ol {
      margin-bottom: 1em;
      padding-left: 1.5em;
    }

    .prose hr {
      border: none;
      border-top: 1px solid var(--color-accent);
      margin: 2em 0;
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      width: 100%;
    }

    /* Header */
    .site-header {
      background-color: var(--color-secondary);
      border-bottom: 1px solid var(--color-accent);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .site-header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .site-logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .site-logo span {
      color: var(--color-highlight);
    }

    .site-nav {
      display: flex;
      gap: 1.5rem;
    }

    .site-nav a {
      color: var(--color-text-muted);
      font-weight: 500;
    }

    .site-nav a:hover {
      color: var(--color-text);
    }

    /* Main content */
    .site-main {
      flex: 1;
      padding: 2rem 0;
    }

    /* Footer */
    .site-footer {
      background-color: var(--color-secondary);
      border-top: 1px solid var(--color-accent);
      padding: 1.5rem 0;
      text-align: center;
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }

    /* Search form */
    .search-form {
      display: flex;
      gap: 0.5rem;
    }

    .search-input {
      background: var(--color-primary);
      border: 1px solid var(--color-accent);
      color: var(--color-text);
      padding: 0.5rem 1rem;
      border-radius: 4px;
      font-size: 0.875rem;
      min-width: 200px;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--color-highlight);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--color-highlight);
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .btn-secondary {
      background: var(--color-accent);
    }

    /* Post list */
    .post-list {
      display: grid;
      gap: 2rem;
    }

    .post-card {
      background: var(--color-secondary);
      border: 1px solid var(--color-accent);
      border-radius: 8px;
      padding: 1.5rem;
      transition: transform 0.2s, border-color 0.2s;
    }

    .post-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-highlight);
    }

    .post-card h2 {
      margin-top: 0;
      margin-bottom: 0.5rem;
    }

    .post-card h2 a {
      color: var(--color-text);
    }

    .post-meta {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
    }

    .post-excerpt {
      color: var(--color-text-muted);
    }

    /* Tags */
    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .tag {
      background: var(--color-accent);
      color: var(--color-text);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
    }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 2rem;
    }

    .pagination a {
      background: var(--color-secondary);
      color: var(--color-text);
      padding: 0.5rem 1rem;
      border-radius: 4px;
      border: 1px solid var(--color-accent);
    }

    .pagination a.active {
      background: var(--color-highlight);
      border-color: var(--color-highlight);
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">Stellar<span>DB</span></a>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </nav>
      <form action="/search" method="GET" class="search-form">
        <input type="search" name="q" placeholder="Search..." class="search-input" required>
        <button type="submit" class="btn">Search</button>
      </form>
    </div>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} {siteTitle}. Powered by Stellar-DB.</p>
    </div>
  </footer>
</body>
</html>
